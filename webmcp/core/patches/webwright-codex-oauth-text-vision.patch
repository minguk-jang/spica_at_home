+
+model:
+  model_class: codex_cli
+  model_name: gpt-5.3-codex-spark
+  codex_sandbox: workspace-write
+  request_timeout_seconds: 300
+  attach_observation_screenshot: false
+
+vision_model:
+  model_class: codex_cli
