{
  "name": "webmcp-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:vite": "vite --host 127.0.0.1 --port 5178 --strictPort",
    "electron:dev": "electron .",
    "electron": "npm run sidecar:build && electron .",
    "app": "npm run build && npm run electron",
    "test:unit": "node --test tests/*.test.ts tests/*.test.cjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "sidecar:build": "cargo build --manifest-path rust/webmcp-sidecar/Cargo.toml",
    "sidecar:test": "cargo test --manifest-path rust/webmcp-sidecar/Cargo.toml"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^42.3.3",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0"
  }
}
